<v:ChromeWindow x:Class="OrtakAlan.Views.ApprovalWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Bağlantı isteği"
               Width="440"
               SizeToContent="Height"
               WindowStartupLocation="CenterScreen"
               Topmost="True"
               ShowInTaskbar="True">
  <Border Padding="28,24,28,22" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" Text="Bağlantı isteği" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <Grid Margin="0,26,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
          <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock x:Name="PeerNameText" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Sohbet ve paylaşımlara erişmek istiyor." TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="Bu bilgisayar için bir kez sorulur." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="LocalText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Reddet" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0" Click="Deny_Click"/>
        <Button Content="İzin ver" Style="{StaticResource PrimaryButton}" MinWidth="108" Click="Allow_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</v:ChromeWindow>
