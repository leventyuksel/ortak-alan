<v:ChromeWindow x:Class="OrtakAlan.Views.SetupWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ortak Alan"
               Width="440"
               SizeToContent="Height"
               WindowStartupLocation="CenterScreen"
               ResizeMode="NoResize">
  <Border Padding="28,26,28,24" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <StackPanel>
      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Ortak Alan" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="İlk kurulum" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Cancel_Click" VerticalAlignment="Top"/>
      </Grid>

      <TextBlock Text="Bu bilgisayar ağda hangi adla görünsün?" Margin="0,28,0,14" TextWrapping="Wrap"/>
      <TextBlock Text="Bilgisayar adı" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="NameBox" AutomationProperties.AutomationId="SetupName" FontSize="15" TextChanged="NameBox_TextChanged"/>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
      <TextBlock Text="Diğer bilgisayarlar sizi bu adla görür." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>

      <Button Content="Devam" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,22,0,0" MinWidth="108" Click="Continue_Click" IsDefault="True" AutomationProperties.AutomationId="SetupContinue"/>
    </StackPanel>
  </Border>
</v:ChromeWindow>
