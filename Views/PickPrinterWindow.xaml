<v:ChromeWindow x:Class="OrtakAlan.Views.PickPrinterWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Yazıcı paylaş"
               Width="380"
               Height="420"
               WindowStartupLocation="CenterOwner">
  <Border Padding="22" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Paylaşılacak yazıcı" FontSize="18" FontWeight="SemiBold"/>
      <ListBox x:Name="PrinterList" Grid.Row="1" Margin="0,14" BorderBrush="{DynamicResource Line}" BorderThickness="1" Foreground="{DynamicResource Ink}" Background="{DynamicResource Paper}" ItemContainerStyle="{StaticResource InkItem}"/>
      <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Yüklü yazıcı bulunamadı." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="İptal" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button Content="Paylaş" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Share_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</v:ChromeWindow>
