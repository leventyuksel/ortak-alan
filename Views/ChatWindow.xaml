<v:ChromeWindow x:Class="OrtakAlan.Views.ChatWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ortak Alan"
               Width="980"
               MinWidth="760"
               MaxWidth="1280"
               MinHeight="520"
               WindowStyle="SingleBorderWindow"
               WindowStartupLocation="Manual"
               ResizeMode="CanResize"
               AllowDrop="True"
               Drop="Window_Drop"
               DragOver="Window_DragOver">
  <Border Background="{DynamicResource Paper}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="14,12,14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
            <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Ortak Alan" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
              <TextBlock x:Name="VersionText" Margin="8,1,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="2,0" MinWidth="22" MinHeight="22" ToolTip="Güncelleme var" Click="Update_Click" Cursor="Hand">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
            <TextBlock x:Name="SelfName" Foreground="{DynamicResource Muted}" FontSize="12"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="OnlineText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,8"/>
        <WrapPanel>
          <Button Content="Klasör paylaş" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,6" MinHeight="32" Click="Folder_Click"/>
          <Button Content="Yazıcı paylaş" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,6" MinHeight="32" Click="Printer_Click"/>
          <Button Content="Paylaşımlar" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,6" MinHeight="32" Click="Shares_Click"/>
          <Button x:Name="TemaButton" Content="Tema" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,6" MinHeight="32" Click="Tema_Click"/>
          <Button Content="Ayarlar" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,6" MinHeight="32" Click="Settings_Click"/>
        </WrapPanel>
        <Popup x:Name="TemaPopup" PlacementTarget="{Binding ElementName=TemaButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="Görünüm" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <UniformGrid Columns="2" Margin="0,0,0,12">
                <Button x:Name="LightButton" Content="Aydınlık" Margin="0,0,4,0" Tag="Aydınlık" Click="Appearance_Click" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="DarkButton" Content="Karanlık" Margin="4,0,0,0" Tag="Karanlık" Click="Appearance_Click" Style="{StaticResource SecondaryButton}"/>
              </UniformGrid>
              <TextBlock Text="Vurgu rengi" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ItemsControl x:Name="TemaSwatches">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="6"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="36" Height="36" Margin="3" Background="Transparent" BorderThickness="0" Click="Swatch_Click" ToolTip="{Binding Name}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Grid>
                            <Ellipse Width="32" Height="32" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="{Binding Selected, Converter={StaticResource BoolVis}}"/>
                            <Ellipse Width="24" Height="24" Fill="{Binding Color}"/>
                          </Grid>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Kişiler" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="10,12,10,2"/>
            <TextBlock DockPanel.Dock="Top" Text="Ağdakiler" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,0,10,8"/>
            <TextBlock x:Name="EmptyPeers" DockPanel.Dock="Top" Text="Ağda kimse yok." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="10,8,10,8"/>
            <ListBox x:Name="PeerList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" ItemContainerStyle="{StaticResource PeerItem}" SelectionChanged="PeerList_SelectionChanged" PreviewMouseRightButtonDown="PeerList_PreviewMouseRightButtonDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Paper}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="PeerTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="16,12,16,8"/>
          <Grid Grid.Row="1">
          <TextBlock x:Name="EmptyChat" Text="Bir bilgisayar seçin." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"/>
          <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto" Padding="14,0,14,8" Background="Transparent">
            <ItemsControl x:Name="Messages">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <Border MaxWidth="280" Padding="12,8" CornerRadius="12" Visibility="{Binding IsFile, Converter={StaticResource NotBoolVis}}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Bubble}"/>
                          <Setter Property="HorizontalAlignment" Value="Left"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Mine}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Accent}"/>
                              <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Mine}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <Button MaxWidth="280" Margin="0,2" Padding="0" Cursor="Hand" ToolTip="Dosyayı aç"
                            Visibility="{Binding IsFile, Converter={StaticResource BoolVis}}"
                            HorizontalAlignment="{Binding Mine, Converter={StaticResource MineAlign}}"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenFile_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="card" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Paper}" CornerRadius="10" Padding="10,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="Aç" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="12"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="card" Property="Background" Value="{DynamicResource Wash}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          <StackPanel Grid.Row="2" Margin="12,8,12,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="Input" IsEnabled="False" PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
            <TextBlock x:Name="Placeholder" Text="Mesaj yazın" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ScreenButton" Content="Ekran" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" Click="Screen_Click"/>
            <Button x:Name="FileButton" Content="Dosya" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" IsEnabled="False" Click="File_Click"/>
            <Button x:Name="SendButton" Content="Gönder" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8" MinHeight="36" IsEnabled="False" Click="Send_Click"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</v:ChromeWindow>
