<v:ChromeWindow x:Class="OrtakAlan.Views.ChatWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ortak Alan"
               Width="980"
               MinWidth="420"
               MinHeight="320"
               WindowStyle="SingleBorderWindow"
               WindowStartupLocation="Manual"
               ResizeMode="CanResize"
               AllowDrop="True"
               PreviewDrop="Window_Drop"
               PreviewDragOver="Window_DragOver">
  <Border Background="{DynamicResource Paper}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="8,8,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,0" Padding="12,6" MinHeight="36" Click="Folder_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Klasör paylaş" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" MinHeight="36" Click="Printer_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Yazıcı paylaş" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" MinHeight="36" Click="Shares_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Paylaşımlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" MinHeight="36" Click="Settings_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Ayarlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateMark" Style="{StaticResource GhostButton}" Visibility="Collapsed" Click="Update_Click" Cursor="Hand" Padding="4,0" MinWidth="22" MinHeight="28" Margin="0,0,2,0" VerticalAlignment="Center">
            <TextBlock Text="!" Foreground="#FFD000" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </Button>
          <Button Style="{StaticResource GhostButton}" Click="Kunye_Click" Cursor="Hand" ToolTip="Künye" Padding="2" MinHeight="28" VerticalAlignment="Center">
            <Border x:Name="LogoFrame" Width="28" Height="28" CornerRadius="7" Background="White">
              <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168" MinWidth="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
          <DockPanel>
            <TextBlock x:Name="SelfName" DockPanel.Dock="Top" Margin="12,10,12,6" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="RoomCard" DockPanel.Dock="Top" Margin="8,0,8,4" MinHeight="48" CornerRadius="8" BorderThickness="1.5" Padding="8,6" Cursor="Hand"
                    BorderBrush="#00F0FF" Background="#D008242C" MouseLeftButtonUp="Room_Click">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#00E5FF"/>
              </Border.Effect>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ortak konuşma" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="Herkes yazar" FontSize="12" Foreground="#9AF6FF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="Kişiler" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="12,0,12,2"/>
            <TextBlock x:Name="OnlineText" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource Muted}" Margin="12,0,12,6"/>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
              <TextBox x:Name="PersonSearch" Padding="8,4" MinHeight="30" FontSize="13" TextChanged="PersonSearch_TextChanged"/>
              <TextBlock x:Name="PersonHint" Text="Kişi ara" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"/>
            </Grid>
            <TextBlock x:Name="EmptyPeers" DockPanel.Dock="Top" Text="Henüz kimse yok." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="10,4,10,8"/>
            <ListBox x:Name="PeerList" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PeerItem}" SelectionChanged="PeerList_SelectionChanged" PreviewMouseRightButtonDown="PeerList_PreviewMouseRightButtonDown">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ScrollViewer Focusable="False" Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <ScrollViewer.Template>
                      <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                          <ScrollContentPresenter/>
                          <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Width="6" Margin="0,4,2,4"
                                     Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                     Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                      </ControlTemplate>
                    </ScrollViewer.Template>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border MinHeight="48" CornerRadius="8" BorderThickness="1.5" Padding="8,6" BorderBrush="{Binding BoxBorder}" Background="{Binding BoxFill}">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="{Binding GlowColor}"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding BoxBorder}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Paper}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PeerTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Column="1">
              <TextBox x:Name="ChatSearch" Padding="8,4" MinHeight="32" FontSize="13" TextChanged="ChatSearch_TextChanged"/>
              <TextBlock x:Name="ChatHint" Text="Konuşmada ara" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"/>
            </Grid>
          </Grid>
          <Grid Grid.Row="1">
          <TextBlock x:Name="EmptyChat" Text="Bir bilgisayar seçin." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"/>
          <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto" Padding="14,0,14,8" Background="Transparent" PreviewMouseRightButtonDown="Transcript_PreviewMouseRightButtonDown">
            <ItemsControl x:Name="Messages">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Author}" FontSize="11" Margin="4,0,0,1" Foreground="#5CEBFF"
                               Visibility="{Binding ShowAuthor, Converter={StaticResource BoolVis}}"/>
                    <Border MaxWidth="280" Padding="12,8" CornerRadius="12" Visibility="{Binding IsFile, Converter={StaticResource NotBoolVis}}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Bubble}"/>
                          <Setter Property="HorizontalAlignment" Value="Left"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Mine}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Accent}"/>
                              <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Mine}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <Button MaxWidth="280" Margin="0,2" Padding="0" Cursor="Hand" ToolTip="Dosyayı aç"
                            Visibility="{Binding IsFile, Converter={StaticResource BoolVis}}"
                            HorizontalAlignment="{Binding Mine, Converter={StaticResource MineAlign}}"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenFile_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="card" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Paper}" CornerRadius="10" Padding="10,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Action}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="12"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="card" Property="Background" Value="{DynamicResource Wash}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,1,4,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"
                               HorizontalAlignment="{Binding Mine, Converter={StaticResource MineAlign}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,2,0" ToolTip="{Binding TickText}"
                                Visibility="{Binding ShowTicks, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#0ABAB5" VerticalAlignment="Center"/>
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#0ABAB5" Margin="-8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding Seen, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          <StackPanel Grid.Row="2" Margin="12,8,12,12">
        <Grid>
          <TextBox x:Name="Input" IsEnabled="False" PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
          <TextBlock x:Name="Placeholder" Text="Mesaj yazın" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ScreenButton" Content="Ekran" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" Click="Screen_Click"/>
            <Button x:Name="FileButton" Content="Dosya" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" IsEnabled="False" Click="File_Click"/>
            <Button x:Name="SendButton" Content="Gönder" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8" MinHeight="36" IsEnabled="False" Click="Send_Click"/>
        </WrapPanel>
        <ProgressBar x:Name="TransferBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Foreground="#0ABAB5" Background="#330ABAB5" BorderThickness="0"/>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</v:ChromeWindow>
