<v:ChromeWindow x:Class="OrtakAlan.Views.ChatWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ortak Alan"
               Width="980"
               MinWidth="420"
               MinHeight="320"
               WindowStyle="SingleBorderWindow"
               WindowStartupLocation="Manual"
               ResizeMode="CanResize"
               AllowDrop="True"
               Drop="Window_Drop"
               DragOver="Window_DragOver">
  <Border Background="{DynamicResource Paper}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,8,8,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
            <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="SelfName" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" Margin="8,1,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Padding="2,0" MinWidth="22" MinHeight="28" ToolTip="Güncelleme var" Click="Update_Click" Cursor="Hand">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="12,6" MinHeight="36" Click="Folder_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Klasör paylaş" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" MinHeight="36" Click="Printer_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Yazıcı paylaş" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" MinHeight="36" Click="Shares_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Paylaşımlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,4,0" Padding="12,6" MinHeight="36" Click="Settings_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Ayarlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168" MinWidth="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Kişiler" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="12,12,12,2"/>
            <TextBlock x:Name="OnlineText" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource Muted}" Margin="12,0,12,8"/>
            <TextBlock x:Name="EmptyPeers" DockPanel.Dock="Top" Text="Ağda kimse yok." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="10,8,10,8"/>
            <ListBox x:Name="PeerList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" ItemContainerStyle="{StaticResource PeerItem}" SelectionChanged="PeerList_SelectionChanged" PreviewMouseRightButtonDown="PeerList_PreviewMouseRightButtonDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="8" BorderThickness="1.5" Padding="8,6" BorderBrush="{Binding BoxBorder}" Background="{Binding BoxFill}">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.9" Color="{Binding GlowColor}"/>
                    </Border.Effect>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding BoxBorder}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Paper}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="PeerTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="16,12,16,8"/>
          <Grid Grid.Row="1">
          <TextBlock x:Name="EmptyChat" Text="Bir bilgisayar seçin." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"/>
          <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto" Padding="14,0,14,8" Background="Transparent" PreviewMouseRightButtonDown="Transcript_PreviewMouseRightButtonDown">
            <ItemsControl x:Name="Messages">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <Border MaxWidth="280" Padding="12,8" CornerRadius="12" Visibility="{Binding IsFile, Converter={StaticResource NotBoolVis}}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Bubble}"/>
                          <Setter Property="HorizontalAlignment" Value="Left"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Mine}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Accent}"/>
                              <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Mine}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <Button MaxWidth="280" Margin="0,2" Padding="0" Cursor="Hand" ToolTip="Dosyayı aç"
                            Visibility="{Binding IsFile, Converter={StaticResource BoolVis}}"
                            HorizontalAlignment="{Binding Mine, Converter={StaticResource MineAlign}}"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenFile_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="card" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Paper}" CornerRadius="10" Padding="10,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="Aç" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="12"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="card" Property="Background" Value="{DynamicResource Wash}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          <StackPanel Grid.Row="2" Margin="12,8,12,12">
        <Grid>
          <TextBox x:Name="Input" IsEnabled="False" PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
          <TextBlock x:Name="Placeholder" Text="Mesaj yazın" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ScreenButton" Content="Ekran" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" Click="Screen_Click"/>
            <Button x:Name="FileButton" Content="Dosya" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,8" MinHeight="36" IsEnabled="False" Click="File_Click"/>
            <Button x:Name="SendButton" Content="Gönder" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8" MinHeight="36" IsEnabled="False" Click="Send_Click"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</v:ChromeWindow>
