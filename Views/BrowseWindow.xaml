<v:ChromeWindow x:Class="OrtakAlan.Views.BrowseWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Klasör"
               Width="440"
               Height="520"
               WindowStartupLocation="CenterScreen">
  <Border Padding="20" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click"/>
      </Grid>
      <ListBox x:Name="FileList" Grid.Row="1" Margin="0,14,0,0" BorderThickness="0" Foreground="{DynamicResource Ink}" ItemContainerStyle="{StaticResource InkItem}" MouseDoubleClick="FileList_MouseDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Geri" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Click="Back_Click"/>
        <Button x:Name="ExplorerButton" Content="Gezginde aç" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Explorer_Click" Visibility="Collapsed"/>
        <Button Content="İndir ve aç" Style="{StaticResource PrimaryButton}" Click="Download_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</v:ChromeWindow>
