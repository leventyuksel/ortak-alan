<v:ChromeWindow x:Class="OrtakAlan.Views.LicenseWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Lisans"
               Width="420"
               SizeToContent="Height"
               WindowStartupLocation="CenterScreen"
               Topmost="True"
               ShowInTaskbar="False">
  <Border Padding="28,24,28,22" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <StackPanel>
      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="White" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Lisans" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
          <TextBlock Text="Ortak Alan" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="BodyText" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Ink}"/>
      <Button Content="Künyeyi aç" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="Open_Click"/>
      <Button Content="Tamam" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="Close_Click" IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </Border>
</v:ChromeWindow>
