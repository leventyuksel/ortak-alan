<v:ChromeWindow x:Class="OrtakAlan.Views.FilesWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Paylaşılan Dosyalar"
               Width="980"
               Height="640"
               MinWidth="760"
               MinHeight="460"
               WindowStartupLocation="CenterScreen"
               AllowDrop="True"
               Drop="Window_Drop"
               DragOver="Window_DragOver"
               PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Background="{DynamicResource Paper}">
    <Border DockPanel.Dock="Top" Padding="12,10,12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
            <Image x:Name="LogoImage" Width="18" Height="18"/>
          </Border>
          <TextBlock Grid.Column="1" Text="Paylaşılan Dosyalar" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="0,10,0,8">
          <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" ToolTip="Geri" Click="Back_Click" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
          <Button x:Name="UpButton" Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" Margin="2,0,0,0" ToolTip="Yukarı" Click="Up_Click" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" Margin="8,0,0,0" ToolTip="Kes" Click="Cut_Click" Content="&#xE8C6;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" ToolTip="Kopyala" Click="Copy_Click" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" ToolTip="Yapıştır" Click="Paste_Click" Content="&#xE77F;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" Margin="8,0,0,0" ToolTip="Yeni klasör" Click="New_Click" Content="&#xE8F4;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" ToolTip="Yeniden adlandır" Click="Rename_Click" Content="&#xE8AC;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" ToolTip="Sil" Click="Delete_Click" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" Margin="8,0,0,0" ToolTip="Yenile" Click="Refresh_Click" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
        </StackPanel>
        <Border Background="{DynamicResource Wash}" CornerRadius="8" Padding="8,4">
          <ItemsControl x:Name="Crumbs">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="{Binding ShowSep, Converter={StaticResource BoolVis}}"/>
                  <Button Content="{Binding Title}" Style="{StaticResource GhostButton}" Padding="6,2" MinHeight="28" Click="Crumb_Click"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12"/>
    </Border>
    <ListView x:Name="Rows" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
              SelectionMode="Extended" MouseDoubleClick="Rows_MouseDoubleClick"
              PreviewMouseRightButtonDown="Rows_PreviewMouseRightButtonDown"
              PreviewMouseLeftButtonDown="Rows_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="Rows_PreviewMouseLeftButtonUp"
              PreviewMouseMove="Rows_PreviewMouseMove"
              SelectionChanged="Rows_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Ad" Width="420">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,3">
                  <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Değiştirme" Width="150" DisplayMemberBinding="{Binding WhenText}"/>
          <GridViewColumn Header="Tür" Width="150" DisplayMemberBinding="{Binding TypeText}"/>
          <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</v:ChromeWindow>
