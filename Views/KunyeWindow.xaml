<v:ChromeWindow x:Class="OrtakAlan.Views.KunyeWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Künye"
               Width="440"
               SizeToContent="Height"
               WindowStartupLocation="CenterScreen"
               Topmost="True"
               ShowInTaskbar="False">
  <Border Padding="28,24,28,22" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="12" Background="White" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="LYazılım" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
          <TextBlock Text="Ortak Alan" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <Button x:Name="UpdateButton" Margin="0,16,0,0" Click="Update_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Cursor="Hand">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
          <TextBlock x:Name="UpdateCaption" Text="Güncellemeleri kontrol et" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <TextBlock x:Name="UpdateNote" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextAlignment="Center" Visibility="Collapsed"/>

      <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0" Foreground="{DynamicResource Ink}"
                 Text="Bu yazılım bilgisayarlar arasında klasör, yazıcı ve mesaj paylaşımı için üretilmiştir. Kopyalanması ve satılması yasaktır. Tüm hakları saklıdır."/>

      <TextBlock x:Name="LicenseState" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
      <TextBlock x:Name="UserState" Margin="0,2,0,0" Foreground="{DynamicResource Muted}" FontSize="12"/>
      <TextBox x:Name="LicenseBox" Margin="0,10,0,0" MinHeight="52" MaxHeight="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Lisans anahtarı"/>
      <Button Content="Lisansı kaydet" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="SaveLicense_Click"/>
      <TextBlock x:Name="LicenseError" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>

      <Button Margin="0,16,0,0" Click="Mail_Click" HorizontalContentAlignment="Stretch" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="card" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="White">
                  <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="İletişim" Foreground="{DynamicResource Muted}" FontSize="12"/>
                  <TextBlock Text="LvntYxl@gmail.com" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,1,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <Button Content="Kapat" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Close_Click" IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </Border>
</v:ChromeWindow>
