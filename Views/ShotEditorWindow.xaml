<v:ChromeWindow x:Class="OrtakAlan.Views.ShotEditorWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ekran alıntısı"
               Width="960"
               Height="680"
               MinWidth="640"
               MinHeight="420"
               WindowStyle="SingleBorderWindow"
               WindowStartupLocation="CenterScreen"
               ResizeMode="CanResize">
  <DockPanel Background="{DynamicResource Paper}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
      <Button Content="Kalem" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Pen_Click"/>
      <Button Content="Fosforlu" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Mark_Click"/>
      <Button Content="Silgi" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Erase_Click"/>
      <Button Content="Geri al" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Undo_Click"/>
      <Button Content="Kaydet" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Save_Click"/>
      <Button Content="Sohbete gönder" Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Wash}">
      <InkCanvas x:Name="Page"/>
    </ScrollViewer>
  </DockPanel>
</v:ChromeWindow>
