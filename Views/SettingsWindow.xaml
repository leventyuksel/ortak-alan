<v:ChromeWindow x:Class="OrtakAlan.Views.SettingsWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:OrtakAlan.Views"
               Title="Ayarlar"
               Width="460"
               SizeToContent="Height"
               WindowStartupLocation="CenterScreen">
  <Border Padding="28,24,28,22" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Paper}">
    <StackPanel>
      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="7" Background="White" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="Ayarlar" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
          <TextBlock Text="Ad, tema ve başlangıç" Foreground="{DynamicResource Muted}" FontSize="13"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click"/>
      </Grid>

      <TextBlock Text="Bilgisayar adı" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,22,0,6"/>
      <TextBox x:Name="NameBox"/>
      <TextBlock x:Name="NameError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>

      <CheckBox x:Name="StartBox" Content="Windows ile başlasın" Foreground="{DynamicResource Ink}" Margin="0,16,0,0"/>
      <TextBlock Text="İşaretli değilse program yalnızca masaüstündeki kısayoldan açılır." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,0"/>

      <TextBlock Text="Tema" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,18,0,8"/>
      <UniformGrid Columns="2">
        <Button x:Name="LightButton" Content="Aydınlık" Margin="0,0,4,0" Tag="Aydınlık" Click="Appearance_Click" Style="{StaticResource SecondaryButton}"/>
        <Button x:Name="DarkButton" Content="Karanlık" Margin="4,0,0,0" Tag="Karanlık" Click="Appearance_Click" Style="{StaticResource SecondaryButton}"/>
      </UniformGrid>
      <ItemsControl x:Name="ThemeSwatches" Margin="0,10,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="6"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="36" Height="36" Margin="3" Background="Transparent" BorderThickness="0" Click="Theme_Click" ToolTip="{Binding Name}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Ellipse Width="32" Height="32" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="{Binding Selected, Converter={StaticResource BoolVis}}"/>
                    <Ellipse Width="24" Height="24" Fill="{Binding Color}"/>
                  </Grid>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Yazı rengi" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,16,0,8"/>
      <ItemsControl x:Name="TextSwatches">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="6"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="36" Height="36" Margin="3" Background="Transparent" BorderThickness="0" Click="Text_Click" ToolTip="{Binding Name}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Ellipse Width="32" Height="32" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="{Binding Selected, Converter={StaticResource BoolVis}}"/>
                    <Ellipse Width="24" Height="24" Fill="{Binding Color}"/>
                  </Grid>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="SampleText" Text="Örnek yazı" Margin="0,8,0,0" FontSize="14"/>

      <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="108" Click="Save_Click"/>
    </StackPanel>
  </Border>
</v:ChromeWindow>
