<Application x:Class="OrtakAlan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OrtakAlan.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolVisConverter x:Key="BoolVis"/>
      <conv:BoolVisConverter x:Key="NotBoolVis" Invert="True"/>
      <conv:MineAlignConverter x:Key="MineAlign"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
